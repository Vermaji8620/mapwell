# MapWell Server Configuration
PORT=5000
NODE_ENV=development

# MongoDB Connection String (Add your remote Atlas or local MongoDB URI here)
# Example: mongodb+srv://<username>:<password>@cluster0.mongodb.net/mapwell?retryWrites=true&w=majority
MONGODB_URI=

# Optional: Enable in-memory MongoDB fallback if MONGODB_URI is empty
USE_MEMORY_DB_FALLBACK=true
